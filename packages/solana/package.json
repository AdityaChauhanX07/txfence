{
  "name": "@txfence/solana",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Solana chain adapter for txfence. Simulation, transaction building, signing, and broadcast for Solana mainnet, devnet, and testnet.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@solana/kit": "^6.8.0",
    "@txfence/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
