{
  "name": "@txfence/react",
  "version": "0.1.2",
  "license": "MIT",
  "description": "React hooks for txfence. Build operator UIs and approval dashboards on top of a txfence agent without re-implementing pipeline state machine logic.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@txfence/core": "0.1.2"
  },
  "devDependencies": {
    "vitest": "^4.1.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "jsdom": "^24.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
