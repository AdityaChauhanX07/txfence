{
  "name": "@txfence/provenance",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Cryptographic provenance chains for txfence. Hash-chained records with Merkle proofs for tamper-evident transaction audit trails.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@txfence/core": "0.1.2"
  },
  "devDependencies": {
    "vitest": "^4.1.5",
    "tsup": "^8.0.0",
    "@types/node": "^20.0.0"
  }
}
