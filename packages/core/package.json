{
  "name": "@txfence/core",
  "version": "0.1.2",
  "license": "MIT",
  "description": "Policy engine and agent orchestration for txfence. Cap locking, receipt storage, webhook approval, temporal rules, intent execution, and chain-agnostic policy expressions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./contracts": {
      "import": "./src/contracts/index.ts",
      "types": "./src/contracts/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "fast-check": "^4.7.0",
    "vitest": "^4.1.5"
  }
}
