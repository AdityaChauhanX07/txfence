{
  "name": "@txfence/cli",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "bin": {
    "txfence": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@txfence/audit": "workspace:*",
    "@txfence/core": "workspace:*",
    "@txfence/evm": "workspace:*",
    "@txfence/mcp": "workspace:*",
    "@txfence/provenance": "workspace:*",
    "@txfence/verify": "workspace:*",
    "commander": "^12.0.0",
    "tsx": "^4.0.0",
    "viem": "^2.48.8"
  },
  "devDependencies": {
    "vitest": "^4.1.5",
    "@types/node": "^20.0.0"
  }
}
