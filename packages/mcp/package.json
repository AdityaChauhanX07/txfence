{
  "name": "@txfence/mcp",
  "version": "0.1.2",
  "license": "MIT",
  "description": "MCP server for txfence. Gives any MCP-compatible AI assistant the ability to simulate, evaluate, and execute on-chain transactions within a declared policy boundary.",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "txfence-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist",
    "start": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@txfence/audit": "0.1.2",
    "@txfence/core": "0.1.2",
    "@txfence/evm": "0.1.2",
    "tsx": "^4.21.0",
    "viem": "^2.48.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "vitest": "^4.1.5"
  }
}
